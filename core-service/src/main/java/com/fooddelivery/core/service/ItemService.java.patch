+    @Transactional
+    public void addBulkOptionToCategory(Long categoryId, ItemOptionRequest request) {
+        List<Item> items = itemRepository.findByCategoryIdOrderBySortOrderAsc(categoryId);
+        for (Item item : items) {
+            ItemOption newOpt = ItemOption.builder()
+                    .item(item)
+                    .groupName(request.getGroupName())
+                    .optionName(request.getOptionName())
+                    .extraPrice(request.getExtraPrice())
+                    .isRequired(request.getIsRequired())
+                    .isMultiple(request.getIsMultiple())
+                    .maxSelect(request.getMaxSelect())
+                    .sortOrder(request.getSortOrder() != null ? request.getSortOrder() : 0)
+                    .isActive(true)
+                    .build();
+            itemOptionRepository.save(newOpt);
+        }
+    }
+
+    @Transactional
+    public void updateBulkOptionInCategory(Long categoryId, BulkItemOptionUpdateRequest request) {
+        itemOptionRepository.updateByCategoryAndNames(
+                categoryId,
+                request.getOldGroupName(), request.getOldOptionName(),
+                request.getNewOption().getGroupName(), request.getNewOption().getOptionName(),
+                request.getNewOption().getExtraPrice(), request.getNewOption().getIsRequired(),
+                request.getNewOption().getIsMultiple(), request.getNewOption().getMaxSelect(),
+                request.getNewOption().getSortOrder() != null ? request.getNewOption().getSortOrder() : 0);
+    }
+
+    @Transactional
+    public void deleteBulkOptionInCategory(Long categoryId, String groupName, String optionName) {
+        itemOptionRepository.deleteByCategoryAndNames(categoryId, groupName, optionName);
+    }
